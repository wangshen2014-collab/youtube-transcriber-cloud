    {
      "start": 303.58,
      "end": 305.58,
      "text": "我跟Kai花了好久時間"
    },
    {
      "start": 305.58,
      "end": 307.58,
      "text": "瘋狂疊帶"
    },
    {
      "start": 307.58,
      "end": 309.58,
      "text": "狂雕狂雕雕出來的"
    },
    {
      "start": 309.58,
      "end": 311.58,
      "text": "大家可以看到現在的"
    },
    {
      "start": 311.58,
      "end": 313.58,
      "text": "整個體驗都"
    },
    {
      "start": 313.58,
      "end": 315.58,
      "text": "我相信都有一定的水準"
    },
    {
      "start": 315.58,
      "end": 317.58,
      "text": "OK但是"
    },
    {
      "start": 317.58,
      "end": 319.58,
      "text": "我希望是可以"
    },
    {
      "start": 319.58,
      "end": 321.58,
      "text": "更進一步的"
    },
    {
      "start": 321.58,
      "end": 323.58,
      "text": "目前的水準我還沒有到完全的滿意"
    },
    {
      "start": 323.58,
      "end": 325.58,
      "text": "所以我希望有足夠"
    },
    {
      "start": 325.58,
      "end": 327.58,
      "text": "強能力的人可以加入我們"
    },
    {
      "start": 327.58,
      "end": 329.58,
      "text": "也把這邊一起做得"
    },
    {
      "start": 329.58,
      "end": 331.58,
      "text": "更好一點"
    },
    {
      "start": 331.58,
      "end": 333.58,
      "text": "我們在找的職位彈性程度"
    },
    {
      "start": 333.58,
      "end": 335.58,
      "text": "也非常大"
    },
    {
      "start": 335.58,
      "end": 337.58,
      "text": "從兼職的人到全職的人"
    },
    {
      "start": 337.58,
      "end": 339.58,
      "text": "到甚至"
    },
    {
      "start": 339.58,
      "end": 341.58,
      "text": "所有人的程度其實我們都有在找"
    },
    {
      "start": 341.58,
      "end": 343.58,
      "text": "我們是非常開放的"
    },
    {
      "start": 343.58,
      "end": 345.58,
      "text": "完全就是依照你的能力"
    },
    {
      "start": 345.58,
      "end": 347.58,
      "text": "就是可以分配"
    },
    {
      "start": 347.58,
      "end": 349.58,
      "text": "相對應的工作給你"
    },
    {
      "start": 349.58,
      "end": 351.58,
      "text": "像現在我們的團隊組成"
    },
    {
      "start": 351.58,
      "end": 353.58,
      "text": "主要就是有"
    },
    {
      "start": 353.58,
      "end": 355.58,
      "text": "兩個工程師都是兼職的"
    },
    {
      "start": 355.58,
      "end": 357.58,
      "text": "在跟我們一起做"
    },
    {
      "start": 357.58,
      "end": 359.58,
      "text": "這些互動式的原件"
    },
    {
      "start": 359.58,
      "end": 361.58,
      "text": "但是"
    },
    {
      "start": 361.58,
      "end": 363.58,
      "text": "如果可以找到全職夥伴"
    },
    {
      "start": 363.58,
      "end": 365.58,
      "text": "我覺得"
    },
    {
      "start": 365.58,
      "end": 367.58,
      "text": "也是完全沒問題"
    },
    {
      "start": 367.58,
      "end": 369.58,
      "text": "分開都是非常大方的"
    },
    {
      "start": 369.58,
      "end": 371.58,
      "text": "你只要問有跟我們"
    },
    {
      "start": 371.58,
      "end": 373.58,
      "text": "合作過的任何工程師"
    },
    {
      "start": 373.58,
      "end": 375.58,
      "text": "就知道我們給的薪水"
    },
    {
      "start": 375.58,
      "end": 377.58,
      "text": "絕對是業界標準之上"
    },
    {
      "start": 377.58,
      "end": 379.58,
      "text": "那甚至是"
    },
    {
      "start": 379.58,
      "end": 381.58,
      "text": "如果你可以證明"
    },
    {
      "start": 381.58,
      "end": 383.58,
      "text": "你能夠幫我們把整個平台"
    },
    {
      "start": 383.58,
      "end": 385.58,
      "text": "的水準又往上"
    },
    {
      "start": 385.58,
      "end": 387.58,
      "text": "提升的話"
    },
    {
      "start": 387.58,
      "end": 389.58,
      "text": "能夠做出這種程度的貢獻的話"
    },
    {
      "start": 389.58,
      "end": 391.58,
      "text": "那我們成為合夥人"
    },
    {
      "start": 391.58,
      "end": 393.58,
      "text": "分股權給你我覺得也是完全"
    },
    {
      "start": 393.58,
      "end": 395.58,
      "text": "沒有問題的我做生意的習慣"
    },
    {
      "start": 395.58,
      "end": 397.58,
      "text": "我覺得有一些"
    },
    {
      "start": 397.58,
      "end": 399.58,
      "text": "該怎麼講"
    },
    {
      "start": 399.58,
      "end": 401.58,
      "text": "有些人做生意呢"
    },
    {
      "start": 401.58,
      "end": 403.58,
      "text": "處處都想要坑人"
    },
    {
      "start": 403.58,
      "end": 405.58,
      "text": "我不是那種人"
    },
    {
      "start": 405.58,
      "end": 407.58,
      "text": "我反而是"
    },
    {
      "start": 407.58,
      "end": 409.58,
      "text": "我寧願我花錢的效率"
    },
    {
      "start": 409.58,
      "end": 411.58,
      "text": "低一點"
    },
    {
      "start": 411.58,
      "end": 413.58,
      "text": "我寧願我花錯錢"
    },
    {
      "start": 413.58,
      "end": 415.58,
      "text": "我也不要錯失真正好的人"
    },
    {
      "start": 415.58,
      "end": 417.58,
      "text": "我是比較偏向這種"
    },
    {
      "start": 417.58,
      "end": 419.58,
      "text": "真正遇到你能夠提供價值的人"
    },
    {
      "start": 419.58,
      "end": 421.58,
      "text": "根據你提供的價值"
    },
    {
      "start": 421.58,
      "end": 423.58,
      "text": "我絕對願意分足夠的"
    },
    {
      "start": 423.58,
      "end": 425.58,
      "text": "就是這樣"
    },
    {
      "start": 425.58,
      "end": 427.58,
      "text": "那除了課程團隊在找人以外"
    },
    {
      "start": 427.58,
      "end": 429.58,
      "text": "我們其實也在找"
    },
    {
      "start": 429.58,
      "end": 431.58,
      "text": "下一堂課的老師"
    },
    {
      "start": 431.58,
      "end": 433.58,
      "text": "那因為這一堂課"
    },
    {
      "start": 433.58,
      "end": 435.58,
      "text": "第一堂AI時代軟體必修課"
    },
    {
      "start": 435.58,
      "end": 437.58,
      "text": "是我跟凱作為老師"
    },
    {
      "start": 437.58,
      "end": 439.58,
      "text": "主要的講師"
    },
    {
      "start": 439.58,
      "end": 441.58,
      "text": "確實課程內容"
    },
    {
      "start": 441.58,
      "end": 443.58,
      "text": "從整個大綱細節"
    },
    {
      "start": 443.58,
      "end": 445.58,
      "text": "編排到內容設計"
    },
    {
      "start": 445.58,
      "end": 447.58,
      "text": "也都是我們來做"
    },
    {
      "start": 447.58,
      "end": 449.58,
      "text": "我們是想要"
    },
    {
      "start": 449.58,
      "end": 451.58,
      "text": "我們選這個題目是因為首先"
    }
