    "source_id": "audio-e142972433ed4ed9e842e663"
  },
  "segments": [
    {
      "start": 0.0,
      "end": 1.8,
      "text": "有一个非常反直觉的真相"
    },
    {
      "start": 1.8,
      "end": 5.0,
      "text": "当某种技术变得像空气和水一样不可或缺时"
    },
    {
      "start": 5.0,
      "end": 6.2,
      "text": "只要没有垄断"
    },
    {
      "start": 6.2,
      "end": 9.6,
      "text": "那么它的商业价值恰恰也就像空气和水一样廉价"
    },
    {
      "start": 9.6,
      "end": 10.4,
      "text": "且无利可图"
    },
    {
      "start": 10.4,
      "end": 11.200000000000001,
      "text": "铁路如此"
    },
    {
      "start": 11.200000000000001,
      "end": 12.0,
      "text": "电力如此"
    },
    {
      "start": 12.0,
      "end": 13.0,
      "text": "互联网如此"
    },
    {
      "start": 13.0,
      "end": 15.6,
      "text": "未来的人工智能也一样会如此"
    },
    {
      "start": 15.6,
      "end": 18.400000000000002,
      "text": "跨越上千公里的火车票只需要百来块钱"
    },
    {
      "start": 18.400000000000002,
      "end": 20.6,
      "text": "能够也练几十公斤钢铁的电费"
    },
    {
      "start": 20.6,
      "end": 22.400000000000002,
      "text": "还不到三瓶饮料的钱"
    },
    {
      "start": 22.400000000000002,
      "end": 24.400000000000002,
      "text": "来自地球另外一端的高清视频"
    },
    {
      "start": 24.400000000000002,
      "end": 26.6,
      "text": "只需要几毛钱的流量费就能获得"
    },
    {
      "start": 26.6,
      "end": 29.200000000000003,
      "text": "互联网时代流量就像自来水一样常见"
    },
    {
      "start": 29.200000000000003,
      "end": 32.2,
      "text": "这也就是为什么全世界范围内造流量的电信公司"
    },
    {
      "start": 32.2,
      "end": 34.8,
      "text": "永远干不过用流量的互联网公司"
    },
    {
      "start": 34.8,
      "end": 36.2,
      "text": "有人说AI不一样"
    },
    {
      "start": 36.2,
      "end": 37.2,
      "text": "它是新科技"
    },
    {
      "start": 37.2,
      "end": 38.2,
      "text": "但是大家可别忘了"
    },
    {
      "start": 38.2,
      "end": 41.400000000000006,
      "text": "30年前的上网也是妥妥的前沿技术"
    },
    {
      "start": 41.400000000000006,
      "end": 45.8,
      "text": "100年前的电在当时更是号称上帝魔法的黑科技"
    },
    {
      "start": 45.8,
      "end": 48.400000000000006,
      "text": "200年前的火车也一样是高科技"
    },
    {
      "start": 48.400000000000006,
      "end": 50.6,
      "text": "AI在本质上和曾经的互联网"
    },
    {
      "start": 50.6,
      "end": 51.6,
      "text": "电力铁路"
    },
    {
      "start": 51.6,
      "end": 53.400000000000006,
      "text": "甚至蒸汽机没有任何的区别"
    },
    {
      "start": 53.400000000000006,
      "end": 56.400000000000006,
      "text": "都依赖于一场声势浩大的基础设施建设"
    },
    {
      "start": 56.6,
      "end": 58.199999999999996,
      "text": "而历史的规律告诉我们"
    },
    {
      "start": 58.199999999999996,
      "end": 61.6,
      "text": "所有属于基础设施层面的企业和行业"
    },
    {
      "start": 61.6,
      "end": 63.6,
      "text": "注定最后都会沦为重资产"
    },
    {
      "start": 63.6,
      "end": 64.4,
      "text": "高风险"
    },
    {
      "start": 64.4,
      "end": 66.2,
      "text": "高杠杆的三高行业"
    },
    {
      "start": 66.2,
      "end": 67.8,
      "text": "他们的特点无一例外"
    },
    {
      "start": 67.8,
      "end": 70.4,
      "text": "都是背负着极其庞大的资本开支"
    },
    {
      "start": 70.4,
      "end": 72.0,
      "text": "承受着极低的资产回报率"
    },
    {
      "start": 72.0,
      "end": 75.2,
      "text": "面临着漫长到令人绝望的回报周期"
    },
    {
      "start": 75.2,
      "end": 77.4,
      "text": "度过最初的疯狂炒作期后"
    },
    {
      "start": 77.4,
      "end": 80.0,
      "text": "他们最终都会沦为盈利平庸"
    },
    {
      "start": 80.0,
      "end": 82.6,
      "text": "只能赚取社会平均利润率的公用事业"
    },
    {
      "start": 82.6,
      "end": 84.6,
      "text": "在任何一场技术革命里面"
    },
    {
      "start": 84.60000000000001,
      "end": 86.60000000000001,
      "text": "最底层的核心基建商"
    },
    {
      "start": 86.60000000000001,
      "end": 89.00000000000001,
      "text": "在经过初期由情绪催动的估值"
    },
    {
      "start": 89.00000000000001,
      "end": 90.80000000000001,
      "text": "和盈利大规模增长之后"
    },
    {
      "start": 90.80000000000001,
      "end": 92.80000000000001,
      "text": "终究会被庞大的资本开支"
    },
    {
      "start": 92.80000000000001,
      "end": 93.60000000000001,
      "text": "资产折旧"
    },
    {
      "start": 93.60000000000001,
      "end": 94.4,
      "text": "产能内卷"
    },
    {
      "start": 94.4,
      "end": 96.00000000000001,
      "text": "和周期率给按回地上"
    },
    {
      "start": 96.00000000000001,
      "end": 97.60000000000001,
      "text": "但是就像巴菲特所说的"
    },
    {
      "start": 97.60000000000001,
      "end": 100.4,
      "text": "绝大多数人等不及慢慢变富"
    },
    {
      "start": 100.4,
      "end": 102.4,
      "text": "太多人渴望在赛跑的第一秒"
    },
    {
      "start": 102.4,
      "end": 103.4,
      "text": "就一击必胜"
    },
    {
      "start": 103.4,
      "end": 104.80000000000001,
      "text": "直接翻身报复"
    },
    {
      "start": 104.80000000000001,
      "end": 106.80000000000001,
      "text": "因此都会选择确定性出现"
    },
    {
      "start": 106.80000000000001,
      "end": 108.60000000000001,
      "text": "最早的新科技基建产业链"
    },
    {
      "start": 108.60000000000001,
      "end": 110.80000000000001,
      "text": "去堵上自己大部分的身家"
    },
    {
      "start": 110.80000000000001,
      "end": 112.4,
      "text": "每一次颠覆性技术"
    },
    {
      "start": 112.4,
      "end": 113.80000000000001,
      "text": "刚开始出现的时候"
    },
    {
      "start": 114.0,
      "end": 116.39999999999999,
      "text": "人们都会因为害怕错过上场的机会"
    },
    {
      "start": 116.39999999999999,
      "end": 119.2,
      "text": "而迅速陷入对相关基建的狂热"
    },
    {
      "start": 119.2,
      "end": 120.8,
      "text": "紧接着把全部的精力"
    },
    {
      "start": 120.8,
      "end": 122.8,
      "text": "投入到对供应链瓶颈的"
    },
    {
      "start": 122.8,
      "end": 123.8,
      "text": "极端炒作之中"
    },
    {
      "start": 123.8,
      "end": 125.0,
      "text": "没有一次是例外"
    },
    {
      "start": 125.0,
      "end": 126.8,
      "text": "这就是人性"
    },
    {
      "start": 126.8,
      "end": 128.4,
      "text": "大家如果把过去三年"
    },
    {
      "start": 128.4,
      "end": 129.8,
      "text": "全球股市轰轰烈烈的"
    },
    {
      "start": 129.8,
      "end": 131.2,
      "text": "AI行情扒开来看"
    },
    {
      "start": 131.2,
      "end": 132.6,
      "text": "就会恍然大悟"
    },
    {
      "start": 132.6,
      "end": 134.6,
      "text": "华尔街和A股这几年炒的"
    },
    {
      "start": 134.6,
      "end": 136.8,
      "text": "根本就不是人工智能本身"
    },
    {
      "start": 136.8,
      "end": 138.0,
      "text": "而是拿着放大镜"
    },
    {
      "start": 138.0,
      "end": 139.4,
      "text": "顺着基建流水线"
    },
    {
      "start": 139.4,
      "end": 140.4,
      "text": "一路摸过去"
    },
    {
      "start": 140.4,
      "end": 141.2,
      "text": "在炒瓶颈"
    },
    {
      "start": 141.2,
      "end": 143.2,
      "text": "谁卡住了算力扩张的脖子"
    },
    {
      "start": 143.20000000000002,
      "end": 145.20000000000002,
      "text": "资本就把谁炒上田"
    },
    {
      "start": 145.20000000000002,
      "end": 146.20000000000002,
      "text": "根据木桶原理"
    },
    {
      "start": 146.20000000000002,
      "end": 148.8,
      "text": "算力产业链没解决一个旧卡点"
    },
    {
      "start": 148.8,
      "end": 151.20000000000002,
      "text": "下一个物理极限就会立刻暴露出来"
    },
    {
      "start": 151.20000000000002,
      "end": 152.00000000000003,
      "text": "不信你看"
    },
    {
      "start": 152.00000000000003,
      "end": 154.4,
      "text": "算上今年AI硬件或者说瓶颈"
    },
    {
      "start": 154.4,
      "end": 156.20000000000002,
      "text": "已经炒作了足足三年多"
    },
    {
      "start": 156.20000000000002,
      "end": 157.4,
      "text": "每次大家觉得"
    },
    {
      "start": 157.4,
      "end": 159.20000000000002,
      "text": "快要轮到AI应用爆发了"
    },
    {
      "start": 159.20000000000002,
      "end": 161.00000000000003,
      "text": "市场都还是会绕回到"
    },
    {
      "start": 161.00000000000003,
      "end": 162.8,
      "text": "硬件炒作上面去"
    },
    {
      "start": 162.8,
      "end": 163.8,
      "text": "刚开始炒的是"
    },
    {
      "start": 163.8,
      "end": 165.8,
      "text": "晶圆与先进封装的瓶颈"
    },
    {
      "start": 165.8,
      "end": 168.00000000000003,
      "text": "2023年大模型刚刚爆发的时候"
    },
    {
      "start": 168.00000000000003,
      "end": 170.00000000000003,
      "text": "芯片封装产能跟不上"
    },
    {
      "start": 170.00000000000003,
      "end": 171.20000000000002,
      "text": "显卡交不上货"
    },
    {
      "start": 171.20000000000002,
      "end": 173.00000000000003,
      "text": "资金就炒作英伟达与台积电"
    },
    {
      "start": 173.00000000000003,
      "end": 174.8,
      "text": "等封装产能翻倍了"
    },
    {
      "start": 174.8,
      "end": 177.4,
      "text": "芯片买回来总不能摆在桌子上面"
    },
    {
      "start": 177.4,
      "end": 180.00000000000003,
      "text": "服务器机架交换机都得跟上"
    },
    {
      "start": 180.00000000000003,
      "end": 182.20000000000002,
      "text": "于是炒服务器和数据中心"
    },
    {
      "start": 182.20000000000002,
      "end": 183.4,
      "text": "机器堆起来"
    },
    {
      "start": 183.4,
      "end": 184.60000000000002,
      "text": "发现电不够用了"
    },
    {
      "start": 184.60000000000002,
      "end": 185.60000000000002,
      "text": "散热跟不上"
    },
    {
      "start": 185.60000000000002,
      "end": 187.00000000000003,
      "text": "接着炒作电力"
    },
    {
      "start": 187.00000000000003,
      "end": 188.60000000000002,
      "text": "核电制冷设备"
    },
    {
      "start": 188.60000000000002,
      "end": 190.20000000000002,
      "text": "甚至当时出现过一句话"
    },
    {
      "start": 190.20000000000002,
      "end": 191.60000000000002,
      "text": "AI的尽头是电力"
    },
    {
      "start": 191.60000000000002,
      "end": 194.60000000000002,
      "text": "再往后推理和agent的消耗越来越大"
    },
    {
      "start": 194.60000000000002,
      "end": 196.20000000000002,
      "text": "算得快还得存得下"
    },
    {
      "start": 196.20000000000002,
      "end": 197.20000000000002,
      "text": "传得动"
    },
    {
      "start": 197.20000000000002,
      "end": 198.4,
      "text": "高带宽存储"
    },
    {
      "start": 198.4,
      "end": 199.20000000000002,
      "text": "高速互联"
    },
    {
      "start": 199.20000000000002,
      "end": 200.00000000000003,
      "text": "定制芯片"
    },
    {
      "start": 200.0,
      "end": 202.0,
      "text": "甚至一度被冷落的CPU"
    },
    {
      "start": 202.0,
      "end": 204.0,
      "text": "又陆续成了资金追逐的对象"
    },
    {
      "start": 204.0,
      "end": 205.6,
      "text": "等芯片和内存凑齐了"
    },
    {
      "start": 205.6,
      "end": 207.4,
      "text": "又撞上了同揽的物理瓶颈"
    },
    {
      "start": 207.4,
      "end": 209.4,
      "text": "于是资金又拥去爆炒800G"
    },
    {
      "start": 209.4,
      "end": 210.4,
      "text": "1.6T光木块"
    },
    {
      "start": 210.4,
      "end": 212.0,
      "text": "和CPU共封装光学"
    },
    {
      "start": 212.0,
      "end": 213.2,
      "text": "等光木块也插上了"
    },
    {
      "start": 213.2,
      "end": 215.2,
      "text": "又卡在了电力与散热的瓶颈之上"
    },
    {
      "start": 215.2,
      "end": 216.2,
      "text": "资金便转回头了"
    },
    {
      "start": 216.2,
      "end": 217.8,
      "text": "又去疯抢液冷设备"
    },
    {
      "start": 217.8,
      "end": 219.2,
      "text": "被压器和核电站"
    },
    {
      "start": 219.2,
      "end": 220.6,
      "text": "在人类历史上"
    },
    {
      "start": 220.6,
      "end": 222.8,
      "text": "每一次新技术诞生之后"
    },
    {
      "start": 222.8,
      "end": 224.6,
      "text": "这种物理瓶颈和产能瓶颈"
    },
    {
      "start": 224.6,
      "end": 226.6,
      "text": "都会迅速成为投机客眼中"
    },
    {
      "start": 226.6,
      "end": 228.4,
      "text": "最性感的一种财富密码"
    },
    {
      "start": 228.4,
      "end": 229.4,
      "text": "这就是过去三年"
    },
    {
      "start": 229.4,
      "end": 230.6,
      "text": "铲子股反复成为"
    },
    {
      "start": 230.6,
      "end": 231.79999999999998,
      "text": "主线的一个核心原因"
    },
    {
      "start": 231.79999999999998,
      "end": 232.79999999999998,
      "text": "大家都还在争论"
    },
    {
      "start": 232.79999999999998,
      "end": 234.4,
      "text": "谁能靠AI赚到大钱"
    },
    {
      "start": 234.4,
      "end": 235.4,
      "text": "卖铲子的"
    },
    {
      "start": 235.4,
      "end": 237.4,
      "text": "已经先从建设AI的人手里面"
    },
    {
      "start": 237.4,
      "end": 238.2,
      "text": "收到钱了"
    },
    {
      "start": 238.2,
      "end": 239.0,
      "text": "200年前"
    },
    {
      "start": 239.0,
      "end": 240.79999999999998,
      "text": "随着蒸汽机和铁路的爆发"
    },
    {
      "start": 240.79999999999998,
      "end": 242.0,
      "text": "整个西方的资本"
    },
    {
      "start": 242.0,
      "end": 243.4,
      "text": "都在追逐钢铁"
    },
    {
      "start": 243.4,
      "end": 244.2,
      "text": "轨道制造"
    },
    {
      "start": 244.2,
      "end": 245.0,
      "text": "车厢制造"
    },
    {
      "start": 245.0,
      "end": 246.2,
      "text": "以及铁路铺设"
    },
    {
      "start": 246.2,
      "end": 247.6,
      "text": "这些基础建设领域"
    },
    {
      "start": 247.6,
      "end": 249.4,
      "text": "物理瓶颈和产能瓶颈"
    },
    {
      "start": 249.4,
      "end": 250.2,
      "text": "同样成了"
    },
    {
      "start": 250.20000000000002,
      "end": 252.8,
      "text": "所有投资人眼中的财富密码"
    },
    {
      "start": 252.8,
      "end": 253.8,
      "text": "手铁危机"
    },
    {
      "start": 253.8,
      "end": 255.8,
      "text": "就是一个绝佳的例子"
    },
    {
      "start": 255.8,
      "end": 257.20000000000005,
      "text": "随着火车越来越重"
    },
    {
      "start": 257.20000000000005,
      "end": 258.40000000000003,
      "text": "速度越来越快"
    },
    {
      "start": 258.40000000000003,
      "end": 260.40000000000003,
      "text": "人们突然意识到一个问题"
    },
    {
      "start": 260.40000000000003,
      "end": 262.6,
      "text": "当时的铁轨是熟铁做的"
    },
    {
      "start": 262.6,
      "end": 263.6,
      "text": "质地太软"
    },
    {
      "start": 263.6,
      "end": 264.6,
      "text": "一些繁忙的铁路"
    },
    {
      "start": 264.6,
      "end": 265.6,
      "text": "每隔几个月"
    },
    {
      "start": 265.6,
      "end": 267.6,
      "text": "铁轨就会开始变形开裂"
    },
    {
      "start": 267.6,
      "end": 269.20000000000005,
      "text": "必须报废更换"
    },
    {
      "start": 269.20000000000005,
      "end": 271.20000000000005,
      "text": "这是手铁材料的物理瓶颈"
