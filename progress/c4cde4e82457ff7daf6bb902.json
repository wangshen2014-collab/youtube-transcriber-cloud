    {
      "start": 313.2,
      "end": 314.2,
      "text": "或者铸造字样"
    },
    {
      "start": 314.2,
      "end": 315.59999999999997,
      "text": "就会疯狂的抢购"
    },
    {
      "start": 315.59999999999997,
      "end": 316.8,
      "text": "这与今天资本市场"
