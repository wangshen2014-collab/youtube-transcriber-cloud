    {
      "start": 328.8,
      "end": 331.0,
      "text": "依然是上游电力基建相关标的"
    },
    {
      "start": 331.0,
      "end": 332.6,
      "text": "比如爱迪生发电机"
    },
    {
      "start": 332.6,
      "end": 334.2,
      "text": "铜导线和电线杆"
    },
    {
      "start": 334.2,
      "end": 335.6,
      "text": "资本把一切"
    },
    {
      "start": 335.6,
      "end": 337.2,
      "text": "与电力基建相关的概念"
