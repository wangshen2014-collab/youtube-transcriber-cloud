    {
      "start": 271.8,
      "end": 273.20000000000005,
      "text": "通过工艺修补来改变"
    },
    {
      "start": 273.20000000000005,
      "end": 273.8,
      "text": "于是资本"
    },
    {
      "start": 273.8,
      "end": 276.0,
      "text": "立刻相信了一套叙事逻辑"
    },
    {
      "start": 276.0,
      "end": 277.6,
      "text": "全社会的一页铁产能"
    },
    {
      "start": 277.6,
      "end": 280.0,
      "text": "将会被用来反复铸造和修补"
