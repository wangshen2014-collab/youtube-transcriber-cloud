      "start": 319.4,
      "end": 320.4,
      "text": "光膜化和变压器的"
    },
    {
      "start": 320.4,
      "end": 321.8,
      "text": "底层逻辑如出一辙"
    },
    {
      "start": 321.8,
      "end": 323.8,
      "text": "一百年前的电力革命初期"
    },
    {
      "start": 323.8,
      "end": 324.8,
      "text": "同样复刻了"
    },
