  "segments": [
    {
      "start": 0.0,
      "end": 2.48,
      "text": "这一周的美股可以说是两个世界"
    },
    {
      "start": 2.48,
      "end": 3.86,
      "text": "大盘涨了"
    },
    {
      "start": 3.86,
      "end": 6.7,
      "text": "NVIDIA却跌了将近13%"
    },
    {
      "start": 6.7,
      "end": 9.74,
      "text": "标普500这一周涨了2.5%"
    },
    {
      "start": 9.74,
      "end": 11.66,
      "text": "结束了连续四周下跌"
    },
    {
      "start": 11.66,
      "end": 13.68,
      "text": "是8月以来最好的一周"
    },
    {
      "start": 13.68,
      "end": 16.88,
      "text": "费城半导体指数涨了8%"
    },
    {
      "start": 16.88,
      "end": 19.6,
      "text": "AMD一周涨了将近19%"
    },
    {
      "start": 19.6,
      "end": 21.96,
      "text": "Broadcom涨了18%"
    },
    {
      "start": 21.96,
      "end": 25.400000000000002,
      "text": "同一个星期NVIDIA跌了将近13%"
    },
    {
      "start": 25.400000000000002,
      "end": 27.62,
      "text": "市值少了将近6000亿美元"
    },
    {
      "start": 27.62,
      "end": 31.34,
      "text": "周五收盘NVIDIA的市值跌破4兆美元"
    },
    {
      "start": 31.34,
      "end": 34.160000000000004,
      "text": "这是2025年7月以来的第一次"
    },
    {
      "start": 34.160000000000004,
      "end": 37.1,
      "text": "这也是NVIDIA连续第六周下跌"
    },
    {
      "start": 37.1,
      "end": 40.92,
      "text": "CNBC说是2012年以来最长的一次"
    },
    {
      "start": 40.92,
      "end": 43.64,
      "text": "这一周NVIDIA和其他晶片股"
    },
    {
      "start": 43.64,
      "end": 45.58,
      "text": "最大的差别是一件事"
    },
    {
      "start": 45.58,
      "end": 47.8,
      "text": "11月12号星期四"
    },
    {
      "start": 47.8,
      "end": 50.34,
      "text": "黄仁勋辞去了NVIDIA的CEO"
    },
    {
      "start": 50.34,
      "end": 53.120000000000005,
      "text": "黄仁勋创办NVIDIA33年"
    },
    {
      "start": 53.120000000000005,
      "end": 55.36,
      "text": "把一家做游戏显示卡的公司"
    },
    {
      "start": 55.36,
      "end": 57.260000000000005,
      "text": "带成一度全世界市值"
    },
    {
      "start": 57.260000000000005,
      "end": 57.6,
      "text": "最高的NVIDIA市值"
    },
    {
      "start": 57.620000000000005,
      "end": 60.86000000000001,
      "text": "所以少了黄仁勋的NVIDIA"
    },
    {
      "start": 60.86000000000001,
      "end": 62.56,
      "text": "市场打算打几折"
    },
    {
      "start": 62.56,
      "end": 65.06,
      "text": "叠掉的这将近6000亿美元"
    },
    {
      "start": 65.06,
      "end": 66.64,
      "text": "是在为不确定打折"
    },
    {
      "start": 66.64,
      "end": 69.12,
      "text": "还是NVIDIA真的变得不值钱了"
    },
    {
      "start": 69.12,
      "end": 70.62,
      "text": "欢迎来到研究院"
    },
    {
      "start": 70.62,
      "end": 73.56,
      "text": "本期的严选周报我们讲四件事"
    },
    {
      "start": 73.56,
      "end": 75.4,
      "text": "这一周的美股发生了什么"
    },
    {
      "start": 75.4,
      "end": 77.22,
      "text": "交棒这一周的三个人"
    },
    {
      "start": 77.22,
      "end": 80.32000000000001,
      "text": "股市在涨的时候债市在担心什么"
    },
    {
      "start": 80.32000000000001,
      "end": 82.54,
      "text": "以及少了黄仁勋的NVIDIA"
    },
    {
      "start": 82.54,
      "end": 84.06,
      "text": "到底被打了几折"
    },
    {
      "start": 87.62,
      "end": 88.76,
      "text": "先看大盘"
    },
    {
      "start": 88.76,
      "end": 91.24000000000001,
      "text": "标普500和费城半导体指数"
    },
    {
      "start": 91.24000000000001,
      "end": 92.74000000000001,
      "text": "开场已经讲过了"
    },
    {
      "start": 92.74000000000001,
      "end": 94.80000000000001,
      "text": "另外纳斯达克综合指数"
    },
    {
      "start": 94.80000000000001,
      "end": 96.82000000000001,
      "text": "一周涨了2.3%"
    },
    {
      "start": 96.82000000000001,
      "end": 99.24000000000001,
      "text": "道琼涨了2.1%"
    },
    {
      "start": 99.24000000000001,
      "end": 100.80000000000001,
      "text": "前几周美股连跌"
    },
    {
      "start": 100.80000000000001,
      "end": 103.10000000000001,
      "text": "上周四还出现了一场股灾"
    },
    {
      "start": 103.10000000000001,
      "end": 106.2,
      "text": "我们上周说要判断股灾结束了没有"
    },
    {
      "start": 106.2,
      "end": 107.64,
      "text": "要看两个线索"
    },
    {
      "start": 107.64,
      "end": 109.16,
      "text": "这周二的通膨数字"
    },
    {
      "start": 109.16,
      "end": 111.04,
      "text": "和下周的NVIDIA财报"
    },
    {
      "start": 111.04,
      "end": 112.96000000000001,
      "text": "第一个线索这周出来了"
    },
    {
      "start": 112.96000000000001,
      "end": 115.22,
      "text": "结果是通膨比预期热"
    },
    {
      "start": 115.22,
      "end": 117.06,
      "text": "但股市还是涨了"
    },
    {
      "start": 117.06,
      "end": 117.60000000000001,
      "text": "这一周的NVIDIA财报"
    },
    {
      "start": 117.62,
      "end": 119.16000000000001,
      "text": "我们一天一天来看"
    },
    {
      "start": 119.16000000000001,
      "end": 121.34,
      "text": "周一油价先帮了忙"
    },
    {
      "start": 121.34,
      "end": 123.9,
      "text": "美国和伊朗传出谈判有进展"
    },
    {
      "start": 123.9,
      "end": 126.4,
      "text": "油价一天跌了4.4%"
    },
    {
      "start": 126.4,
      "end": 128.8,
      "text": "油价跌通膨压力就小一点"
    },
    {
      "start": 128.8,
      "end": 131.84,
      "text": "加上晶片股从前一周的大跌中回升"
    },
    {
      "start": 131.84,
      "end": 133.46,
      "text": "股市跟着反弹"
    },
    {
      "start": 133.46,
      "end": 135.94,
      "text": "标普500 11个类股全部上涨"
    },
    {
      "start": 135.94,
      "end": 139.1,
      "text": "费城半导体指数一天涨了将近7%"
    },
    {
      "start": 139.1,
      "end": 141.18,
      "text": "成分股里只有NVIDIA下跌"
    },
    {
      "start": 141.18,
      "end": 144.48000000000002,
      "text": "周二10月的消费者物价指数公布"
    },
    {
      "start": 144.48000000000002,
      "end": 147.18,
      "text": "整体物价一个月涨了0.4%"
    },
    {
      "start": 147.18,
      "end": 147.6,
      "text": "扣掉了1.5%"
    },
    {
      "start": 147.6,
      "end": 151.01999999999998,
      "text": "扣掉食物和能源的核心物价涨了0.3%"
    },
    {
      "start": 151.01999999999998,
      "end": 154.18,
      "text": "两个数字都比预期高了0.1个百分点"
    },
    {
      "start": 154.18,
      "end": 154.96,
      "text": "周三"
    },
    {
      "start": 154.96,
      "end": 158.57999999999998,
      "text": "AI云端公司CoreWeave前一天晚上公布的财报"
    },
    {
      "start": 158.57999999999998,
      "end": 160.38,
      "text": "把晶片股又拉了起来"
    },
    {
      "start": 160.38,
      "end": 163.85999999999999,
      "text": "CoreWeave这一季营收年增168%"
    },
    {
      "start": 163.85999999999999,
      "end": 167.85999999999999,
      "text": "手上还没交付的订单增加到1325亿美元"
    },
    {
      "start": 167.85999999999999,
      "end": 171.34,
      "text": "CoreWeave周三一天涨了将近25%"
    },
    {
      "start": 171.34,
      "end": 174.76,
      "text": "记忆体大厂美光也涨了将近12%"
    },
    {
      "start": 174.76,
      "end": 175.2,
      "text": "周四"
    },
    {
      "start": 175.2,
      "end": 176.48,
      "text": "美东时间盘前"
    },
    {
      "start": 176.48,
      "end": 177.48,
      "text": "NVIDIA宣布"
    },
    {
      "start": 177.6,
      "end": 178.92,
      "text": "黄仁勋辞职"
    },
    {
      "start": 178.92,
      "end": 181.56,
      "text": "财务长Colette Kress站待CEO"
    },
    {
      "start": 181.56,
      "end": 182.51999999999998,
      "text": "10月底以来"
    },
    {
      "start": 182.51999999999998,
      "end": 186.2,
      "text": "黄仁勋先后卷入间谍疑云和婚外情风波"
    },
    {
      "start": 186.2,
      "end": 189.04,
      "text": "国会和NVIDIA董事会都介入调查"
    },
    {
      "start": 189.04,
      "end": 190.24,
      "text": "完整的来龙去脉"
    },
    {
      "start": 190.24,
      "end": 192.24,
      "text": "我们这周已经做了几支专题"
    },
    {
      "start": 192.24,
      "end": 193.68,
      "text": "这里只看股价"
    },
    {
      "start": 193.68,
      "end": 194.51999999999998,
      "text": "前一天晚上"
    },
    {
      "start": 194.51999999999998,
      "end": 195.72,
      "text": "华尔街日报报道"
    },
    {
      "start": 195.72,
      "end": 197.84,
      "text": "董事会准备撤换黄仁勋"
    },
    {
      "start": 197.84,
      "end": 200.16,
      "text": "NVIDIA盘后就跌了8%"
    },
    {
      "start": 200.16,
      "end": 201.84,
      "text": "周四早盘一度大跌"
    },
    {
      "start": 201.84,
      "end": 203.94,
      "text": "收盘跌了4.3%"
    },
    {
      "start": 203.94,
      "end": 204.54,
      "text": "同一天"
    },
    {
      "start": 204.54,
      "end": 207.57999999999998,
      "text": "对手AMD和Broadcom都涨了5个多百分点"
    },
    {
      "start": 207.6,
      "end": 208.51999999999998,
      "text": "周五"
    },
    {
      "start": 208.51999999999998,
      "end": 210.07999999999998,
      "text": "涨多的科技股回头"
    },
    {
      "start": 210.07999999999998,
      "end": 212.84,
      "text": "科技类股是11个类股里跌最多的"
    },
    {
      "start": 212.84,
      "end": 215.5,
      "text": "AMD一天跌了将近9%"
    },
    {
      "start": 215.5,
      "end": 219.38,
      "text": "思科和应用材料前一天晚上公布的财报都比预期好"
    },
    {
      "start": 219.38,
      "end": 220.68,
      "text": "股价却都下跌"
    },
    {
      "start": 220.68,
      "end": 222.66,
      "text": "思科跌了6%"
    },
    {
      "start": 222.66,
      "end": 224.74,
      "text": "那现在离高点还有多远"
    },
    {
      "start": 224.74,
      "end": 228.07999999999998,
      "text": "标普500离历史高点3.3%"
    },
    {
      "start": 228.07999999999998,
      "end": 229.35999999999999,
      "text": "纳斯达克100指数"
    },
    {
      "start": 229.35999999999999,
      "end": 231.95999999999998,
      "text": "也就是纳斯达克最大的100家公司"
    },
    {
      "start": 231.95999999999998,
      "end": 234.0,
      "text": "离高点10.5%"
    },
    {
      "start": 234.0,
      "end": 237.45999999999998,
      "text": "费城半导体指数离高点30.7%"
    },
    {
      "start": 237.45999999999998,
      "end": 237.57999999999998,
      "text": "恐吓了"
    },
    {
      "start": 237.58,
      "end": 241.98000000000002,
      "text": "恐慌指数VIX从上周五的25.6回到19.3"
    },
    {
      "start": 241.98000000000002,
      "end": 243.4,
      "text": "又回到20以下"
    },
    {
      "start": 243.4,
      "end": 244.64000000000001,
      "text": "另外两个资产"
    },
    {
      "start": 244.64000000000001,
      "end": 246.52,
      "text": "这周走势和股市相反"
    },
    {
      "start": 246.52,
      "end": 248.94,
      "text": "黄金一周跌了4.6%"
    },
    {
      "start": 248.94,
      "end": 250.28,
      "text": "比特币跌了一成"
    },
    {
      "start": 250.28,
      "end": 252.26000000000002,
      "text": "原因我们放到第三张讲"
    },
    {
      "start": 252.26000000000002,
      "end": 258.40000000000003,
      "text": "这一周的交棒牵涉到三个人"
    },
    {
      "start": 258.40000000000003,
      "end": 259.0,
      "text": "走的人"
    },
    {
      "start": 259.0,
      "end": 259.82,
      "text": "接的人"
    },
    {
      "start": 259.82,
      "end": 261.32,
      "text": "还有被点名的人"
    },
    {
      "start": 261.32,
      "end": 263.88,
      "text": "第一位走的人黄仁勋"
    },
    {
      "start": 263.88,
      "end": 265.38,
      "text": "黄仁勋这一周"
    },
    {
      "start": 265.38,
      "end": 267.44,
      "text": "从CEO和董事的位置上"
    },
    {
      "start": 267.44,
      "end": 267.88,
      "text": "离开"
    },
    {
      "start": 267.88,
      "end": 269.1,
      "text": "人虽然走了"
    },
    {
      "start": 269.1,
      "end": 270.32,
      "text": "事情还没完"
    },
    {
      "start": 270.32,
      "end": 271.92,
      "text": "众议院三个委员会"
    },
    {
      "start": 271.92,
      "end": 274.48,
      "text": "要他12月1号接受闭门访谈"
    },
    {
      "start": 274.48,
      "end": 276.14,
      "text": "参议院银行委员会"
    },
    {
      "start": 276.14,
      "end": 277.42,
      "text": "也要他出席听证"
    },
    {
      "start": 277.42,
      "end": 279.56,
      "text": "NVIDIA董事会的内部调查"
    },
    {
      "start": 279.56,
      "end": 282.22,
      "text": "根据NBC引述知情人士的说法"
    },
    {
      "start": 282.22,
      "end": 284.34,
      "text": "在他辞职以后还会继续"
    },
    {
      "start": 284.34,
      "end": 287.44,
      "text": "不过也有很多人站在黄仁勋这一边"
    },
    {
      "start": 287.44,
      "end": 288.84,
      "text": "根据WIRED的报道"
    },
    {
      "start": 288.84,
      "end": 291.42,
      "text": "NVIDIA有员工在内部论坛发文"
    },
    {
      "start": 291.42,
      "end": 293.76,
      "text": "要董事会先听听员工的意见"
    },
    {
      "start": 293.76,
      "end": 295.0,
      "text": "这篇贴文底下"
    },
    {
      "start": 295.0,
      "end": 296.64,
      "text": "有1600多则留言"
    },
    {
      "start": 296.64,
      "end": 297.3,
      "text": "其中不少人说"
    },
    {
      "start": 297.3,
      "end": 298.7,
      "text": "不少人希望他回来"
    },
    {
      "start": 298.7,
      "end": 300.58,
      "text": "此外根据CNN报道"
    },
    {
      "start": 300.58,
      "end": 303.02000000000004,
      "text": "川普这周多次打电话给黄仁勋"
    },
    {
      "start": 303.02000000000004,
      "end": 306.42,
      "text": "一开始还鼓励他继续争取留下来"
    },
    {
      "start": 306.42,
      "end": 307.66,
      "text": "第二位接的人"
    },
    {
      "start": 307.66,
      "end": 308.66,
      "text": "Colette Kress"
    },
    {
      "start": 308.66,
      "end": 312.1,
      "text": "Kress从2013年起当NVIDIA的财务长"
    },
    {
      "start": 312.1,
      "end": 313.62,
      "text": "这次暂待CEO"
    },
    {
      "start": 313.62,
      "end": 315.96000000000004,
      "text": "财务长的工作也还在她身上"
    },
    {
      "start": 315.96000000000004,
      "end": 317.42,
      "text": "华尔街对她很熟"
    },
    {
      "start": 317.42,
      "end": 318.78000000000003,
      "text": "因为过去十几年"
    },
    {
      "start": 318.78000000000003,
      "end": 320.32,
      "text": "NVIDIA的财报会议上"
    },
    {
      "start": 320.32,
      "end": 322.58000000000004,
      "text": "报告财务数字的主要就是她"
    },
    {
      "start": 322.58000000000004,
      "end": 324.1,
      "text": "下周二的财报会议"
    },
    {
      "start": 324.1,
      "end": 326.6,
      "text": "是她第一次以CEO的身份上场"
    },
    {
      "start": 326.6,
      "end": 327.28000000000003,
      "text": "第四位"
    },
    {
      "start": 327.28000000000003,
      "end": 327.88000000000005,
      "text": "第三位"
    },
    {
      "start": 327.88000000000005,
      "end": 329.04,
      "text": "被点名的人"
    },
    {
      "start": 329.04,
      "end": 330.04,
      "text": "ARM的CEO"
    },
    {
      "start": 330.04,
      "end": 331.28000000000003,
      "text": "Rene Haas"
    },
    {
      "start": 331.28000000000003,
      "end": 332.76000000000005,
      "text": "金融时报周五报道"
    },
    {
      "start": 332.76000000000005,
      "end": 334.92,
      "text": "NVIDIA董事会已经接触Haas"
    },
    {
      "start": 334.92,
      "end": 336.6,
      "text": "当作接班人选之一"
