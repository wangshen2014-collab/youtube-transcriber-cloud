    {
      "start": 222.62,
      "end": 225.04,
      "text": "市场赚钱变得非常的难"
    },
    {
      "start": 225.04,
      "end": 226.84,
      "text": "每个人都在拼命"
    },
    {
      "start": 226.84,
      "end": 228.06,
      "text": "拼命干嘛呢"
    },
    {
      "start": 228.06,
      "end": 230.44,
      "text": "想保持账户的稳定"
    },
    {
      "start": 230.44,
      "end": 231.62,
      "text": "它都不太容易"
    },
    {
      "start": 231.62,
      "end": 234.52,
      "text": "所以其实截止到目前为止"
