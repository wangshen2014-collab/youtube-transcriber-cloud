    },
    {
      "start": 5.38,
      "end": 6.84,
      "text": "26年11月9号"
    },
    {
      "start": 6.84,
      "end": 9.040000000000001,
      "text": "周一晚上的7点55分"
    },
    {
      "start": 9.040000000000001,
      "end": 12.34,
      "text": "哎呀,这个市场可真热闹啊"
