  },
  "segments": [
    {
      "start": 0.0,
      "end": 1.4000000000000001,
      "text": "我最近意外的发现"
    },
    {
      "start": 1.4000000000000001,
      "end": 3.88,
      "text": "不少人认为中国现在的经济萎靡"
    },
    {
      "start": 3.88,
      "end": 6.640000000000001,
      "text": "只是在经历一次周期性的低谷"
    },
    {
      "start": 6.640000000000001,
      "end": 8.16,
      "text": "熬过去就会复苏了"
    },
    {
      "start": 8.16,
      "end": 9.040000000000001,
      "text": "但问题是"
    },
    {
      "start": 9.040000000000001,
      "end": 11.52,
      "text": "就连中国政府自己都不认为"
    },
    {
      "start": 11.52,
      "end": 13.88,
      "text": "现在经济差是周期性的了"
    },
    {
      "start": 13.88,
      "end": 15.72,
      "text": "早就不提什么复苏了"
    },
    {
      "start": 15.72,
      "end": 16.76,
      "text": "民生凋敝"
    },
    {
      "start": 16.76,
      "end": 17.72,
      "text": "青年失业"
    },
    {
      "start": 17.72,
      "end": 18.6,
      "text": "消费疲软"
    },
    {
      "start": 18.6,
      "end": 21.8,
      "text": "其实都是有意为之的既定目标"
    },
    {
      "start": 21.8,
      "end": 23.88,
      "text": "中国政府包括习主席的表态"
    },
    {
      "start": 23.88,
      "end": 24.88,
      "text": "也一直很明确"
    },
    {
      "start": 24.88,
      "end": 27.36,
      "text": "中国经济非但没有出问题"
    },
    {
      "start": 27.4,
      "end": 29.96,
      "text": "反而运行在正确的轨道上面"
    },
    {
      "start": 29.96,
      "end": 32.16,
      "text": "因此根本不需要所谓的调整"
    },
    {
      "start": 32.16,
      "end": 32.84,
      "text": "没有调整"
    },
    {
      "start": 32.84,
      "end": 34.2,
      "text": "何来复苏呢"
    },
    {
      "start": 34.2,
      "end": 35.12,
      "text": "本期节目"
    },
    {
      "start": 35.12,
      "end": 36.84,
      "text": "请允许我向大家解释"
    },
    {
      "start": 36.84,
      "end": 39.92,
      "text": "习近平政府当前的经济政策逻辑"
    },
    {
      "start": 39.92,
      "end": 41.8,
      "text": "我们从一个重要的经济指标"
    },
    {
      "start": 41.8,
      "end": 42.2,
      "text": "切入"
    },
    {
      "start": 42.2,
      "end": 43.879999999999995,
      "text": "就是工业补贴"
    },
    {
      "start": 43.879999999999995,
      "end": 46.120000000000005,
      "text": "根据国际货币基金组织的估算"
    },
    {
      "start": 46.120000000000005,
      "end": 47.68,
      "text": "中国目前的工业补贴"
    },
    {
      "start": 47.68,
      "end": 50.96,
      "text": "占GDP的4%到4.4%"
    },
    {
      "start": 50.96,
      "end": 52.44,
      "text": "但这是在25年"
    },
    {
      "start": 52.44,
      "end": 54.8,
      "text": "根据23年的数据测算得出的"
    },
    {
      "start": 54.8,
      "end": 56.32,
      "text": "目前实际更高"
    },
    {
      "start": 56.32,
      "end": 57.76,
      "text": "这不仅在纵向上"
    },
    {
      "start": 57.76,
      "end": 60.24,
      "text": "和中国自己过去几十年相比"
    },
    {
      "start": 60.24,
      "end": 61.0,
      "text": "是超高的"
    },
    {
      "start": 61.0,
      "end": 63.480000000000004,
      "text": "横向上和其他的经济体相比"
    },
    {
      "start": 63.480000000000004,
      "end": 64.52,
      "text": "也是超高的"
    },
    {
      "start": 64.52,
      "end": 67.8,
      "text": "OECD国家通常维持在0.5%以下"
    },
    {
      "start": 67.8,
      "end": 69.72,
      "text": "美国是0.39%"
    },
    {
      "start": 69.72,
      "end": 73.72,
      "text": "欧盟国家在0.94%到1.5%之间"
    },
    {
      "start": 73.72,
      "end": 76.36,
      "text": "日本是0.5%到0.7%"
    },
    {
      "start": 76.36,
      "end": 77.03999999999999,
      "text": "也就是说"
    },
    {
      "start": 77.03999999999999,
      "end": 78.6,
      "text": "中国现在的工业补贴"
    },
    {
      "start": 78.6,
      "end": 80.88,
      "text": "是多数国家的5到7倍"
    },
    {
      "start": 80.88,
      "end": 81.76,
      "text": "从这个数据"
    },
    {
      "start": 81.76,
      "end": 82.84,
      "text": "我们不难看出"
    },
    {
      "start": 82.84,
      "end": 85.88,
      "text": "中国目前整个社会集体创造的"
    },
    {
      "start": 85.92,
      "end": 86.96,
      "text": "财富和资源"
    },
    {
      "start": 86.96,
      "end": 88.56,
      "text": "通过现金补贴"
    },
    {
      "start": 88.56,
      "end": 89.6,
      "text": "廉价信贷"
    },
    {
      "start": 89.6,
      "end": 90.52,
      "text": "土地出让"
    },
    {
      "start": 90.52,
      "end": 91.83999999999999,
      "text": "地方财政支援"
    },
    {
      "start": 91.83999999999999,
      "end": 93.32,
      "text": "等等各种方式"
    },
    {
      "start": 93.32,
      "end": 96.0,
      "text": "大量的倾斜到了习近平所提上的"
    },
    {
      "start": 96.0,
      "end": 97.88,
      "text": "由党和国家控制的"
    },
    {
      "start": 97.88,
      "end": 99.03999999999999,
      "text": "新制生产力"
    },
    {
      "start": 99.03999999999999,
      "end": 100.47999999999999,
      "text": "高端制造等等"
    },
    {
      "start": 100.47999999999999,
      "end": 101.75999999999999,
      "text": "战略性新兴产业"
    },
    {
      "start": 101.75999999999999,
      "end": 103.91999999999999,
      "text": "比如说芯片新能源"
    },
    {
      "start": 103.91999999999999,
      "end": 105.12,
      "text": "AI机器人"
    },
    {
      "start": 105.12,
      "end": 106.56,
      "text": "军工重工等等"
    },
    {
      "start": 106.56,
      "end": 108.28,
      "text": "很多人说这么做不好吗"
    },
    {
      "start": 108.28,
      "end": 109.75999999999999,
      "text": "这不是发展科技吗"
    },
    {
      "start": 109.75999999999999,
      "end": 110.72,
      "text": "我们先说说"
    },
    {
      "start": 110.72,
      "end": 112.19999999999999,
      "text": "这么做的结果是什么"
    },
    {
      "start": 112.19999999999999,
      "end": 113.8,
      "text": "再说为什么要这么做"
    },
    {
      "start": 113.8,
      "end": 115.72,
      "text": "这么做的第一个必然结果"
    },
    {
      "start": 115.72,
      "end": 117.0,
      "text": "就是内需不振"
    },
    {
      "start": 117.0,
      "end": 118.28,
      "text": "民生凋敝"
    },
    {
      "start": 118.28,
      "end": 120.12,
      "text": "中国政府把钱花在这些"
    },
    {
      "start": 120.12,
      "end": 121.92,
      "text": "党有的高端产业上面"
    },
    {
      "start": 121.92,
      "end": 123.32,
      "text": "直接的结果就是"
    },
    {
      "start": 123.32,
      "end": 124.6,
      "text": "挤压民有的"
    },
    {
      "start": 124.6,
      "end": 125.84,
      "text": "所谓低端产业"
    },
    {
      "start": 125.84,
      "end": 128.07999999999998,
      "text": "导致民营经济部门的萧条"
    },
    {
      "start": 128.07999999999998,
      "end": 128.84,
      "text": "习近平说"
    },
    {
      "start": 128.84,
      "end": 130.84,
      "text": "我们中国不搞社会福利那一套"
    },
    {
      "start": 130.84,
      "end": 131.76,
      "text": "会养来人的"
    },
    {
      "start": 131.76,
      "end": 134.52,
      "text": "因此中国政府是有意不提供"
    },
    {
      "start": 134.52,
      "end": 135.52,
      "text": "免费的教育"
    },
    {
      "start": 135.52,
      "end": 136.6,
      "text": "医疗和养老"
    },
    {
      "start": 136.6,
      "end": 137.96,
      "text": "这些社会保障体系的"
    },
    {
      "start": 137.96,
      "end": 140.2,
      "text": "这让老百姓害怕以后没有保障"
    },
    {
      "start": 140.2,
      "end": 141.96,
      "text": "就会自然而然的进行"
    },
    {
      "start": 141.96,
      "end": 143.0,
      "text": "预防性的存款"
    },
    {
      "start": 143.0,
      "end": 143.76,
      "text": "不敢消费"
    },
    {
      "start": 143.76,
      "end": 145.48,
      "text": "很多人说中国存款高"
    },
    {
      "start": 145.48,
      "end": 146.51999999999998,
      "text": "消费低是问题"
    },
    {
      "start": 146.51999999999998,
      "end": 148.32,
      "text": "其实这都是计划之内的"
    },
    {
      "start": 148.32,
      "end": 150.28,
      "text": "政府也不想让老百姓消费"
    },
    {
      "start": 150.28,
      "end": 151.67999999999998,
      "text": "正好把这些存款"
    },
    {
      "start": 151.67999999999998,
      "end": 153.79999999999998,
      "text": "用于投资和补贴新兴行业"
    },
    {
      "start": 153.79999999999998,
      "end": 155.44,
      "text": "造成更深层次的"
    },
    {
      "start": 155.44,
      "end": 156.56,
      "text": "收入分配不均"
    },
    {
      "start": 156.56,
      "end": 157.35999999999999,
      "text": "挤压民生"
    },
    {
      "start": 157.35999999999999,
      "end": 158.72,
      "text": "所以说中国的消费"
    },
    {
      "start": 158.72,
      "end": 160.07999999999998,
      "text": "长期站在GDP的"
    },
    {
      "start": 160.07999999999998,
      "end": 161.56,
      "text": "40%上下"
    },
    {
      "start": 161.56,
      "end": 164.48,
      "text": "远远低于含落后国家在内"
    },
    {
      "start": 164.48,
      "end": 166.44,
      "text": "全世界平均下来的那个水平"
    },
    {
      "start": 166.44,
      "end": 167.23999999999998,
      "text": "60%"
    },
    {
      "start": 167.23999999999998,
      "end": 168.95999999999998,
      "text": "更不要说和相对繁荣的"
    },
    {
      "start": 168.95999999999998,
      "end": 169.92,
      "text": "经济体相比了"
    },
    {
      "start": 169.92,
      "end": 171.04,
      "text": "没有消费"
    },
    {
      "start": 171.04,
      "end": 172.51999999999998,
      "text": "自然也就无法带动"
    },
    {
      "start": 172.52,
      "end": 173.96,
      "text": "市场经济向前发展"
    },
    {
      "start": 173.96,
      "end": 176.44,
      "text": "但这一切都是计划之内的"
    },
    {
      "start": 176.44,
      "end": 177.76000000000002,
      "text": "第二个必然结果就是"
    },
    {
      "start": 177.76000000000002,
      "end": 179.84,
      "text": "我们现在看到的大面积失业"
    },
    {
      "start": 179.84,
      "end": 180.88,
      "text": "有人可能会问"
    },
    {
      "start": 180.88,
      "end": 182.84,
      "text": "政府怎么可能有意让失业呢"
    },
    {
      "start": 182.84,
      "end": 184.16000000000003,
      "text": "对它有什么好处呢"
    },
    {
      "start": 184.16000000000003,
      "end": 185.92000000000002,
      "text": "中国政府大力支持的"
    },
    {
      "start": 185.92000000000002,
      "end": 188.12,
      "text": "高端行业需要高技能人才"
    },
    {
      "start": 188.12,
      "end": 189.60000000000002,
      "text": "但占中国劳动力"
    },
    {
      "start": 189.60000000000002,
      "end": 191.16000000000003,
      "text": "绝大多数的是什么"
    },
    {
      "start": 191.16000000000003,
      "end": 193.20000000000002,
      "text": "是中低端技能人群"
    },
    {
      "start": 193.20000000000002,
      "end": 194.60000000000002,
      "text": "2.81的农民工"
    },
    {
      "start": 194.60000000000002,
      "end": 197.20000000000002,
      "text": "每年1200多万的高校毕业生"
    },
    {
      "start": 197.20000000000002,
      "end": 199.68,
      "text": "以及无数集中在传统制造"
    },
    {
      "start": 199.68,
      "end": 201.72,
      "text": "物流低端服务业里面的"
    },
    {
      "start": 201.72,
      "end": 203.76,
      "text": "没上过大学的那些劳动力"
    },
    {
      "start": 203.76,
      "end": 206.28,
      "text": "他们需要的是劳动密集型的"
    },
    {
      "start": 206.28,
      "end": 207.72,
      "text": "中低技术岗位"
    },
    {
      "start": 207.72,
      "end": 209.56,
      "text": "而不是芯片设计"
    },
    {
      "start": 209.56,
      "end": 211.84,
      "text": "AI算法或者什么高端制造"
    },
    {
      "start": 211.84,
      "end": 213.12,
      "text": "绝大多数中国人"
    },
    {
      "start": 213.12,
      "end": 215.16,
      "text": "是吃不了习主席这碗饭的"
    },
    {
      "start": 215.16,
      "end": 217.2,
      "text": "这就造成了中国的劳动力"
    },
    {
      "start": 217.2,
      "end": 218.2,
      "text": "供给结构"
    },
    {
      "start": 218.2,
      "end": 219.36,
      "text": "和习近平主导的"
    },
    {
      "start": 219.36,
      "end": 220.88,
      "text": "这个高端制造优先"
    },
    {
      "start": 220.88,
      "end": 223.2,
      "text": "所创造出来的就业需求之间"
    },
    {
      "start": 223.2,
      "end": 224.6,
      "text": "是严重错配的"
    },
    {
      "start": 224.6,
      "end": 226.52,
      "text": "而且这不是发展几年"
    },
    {
      "start": 226.52,
      "end": 227.88,
      "text": "几十年就可以改变的"
    },
    {
      "start": 227.88,
      "end": 229.52,
      "text": "智力水平低于100的人"
    },
    {
      "start": 229.52,
      "end": 231.24,
      "text": "在人口当中正向分布"
    },
    {
      "start": 231.24,
      "end": 232.96,
      "text": "每个国家每个学校"
    },
    {
      "start": 232.96,
      "end": 235.72,
      "text": "都有一半以上的这种低智力人群"
    },
    {
      "start": 235.72,
      "end": 238.4,
      "text": "他们怎么发展怎么努力学"
    },
    {
      "start": 238.4,
      "end": 241.04000000000002,
      "text": "都干不了您的那些宝贝产业的"
    },
    {
      "start": 241.04000000000002,
      "end": 243.04000000000002,
      "text": "就算绝大多数的大学生"
    },
    {
      "start": 243.04000000000002,
      "end": 243.92000000000002,
      "text": "也都干不了"
    },
    {
      "start": 243.92000000000002,
      "end": 246.56,
      "text": "他们需要没那么尖端的普通行业"
    },
    {
      "start": 246.56,
      "end": 248.4,
      "text": "如果普通行业被打压了呢"
    },
    {
      "start": 248.4,
      "end": 251.56,
      "text": "那普通人就只能进入灵活就业"
    },
    {
      "start": 251.56,
      "end": 253.20000000000002,
      "text": "比如说外卖网约车"
    },
    {
      "start": 253.20000000000002,
      "end": 255.88,
      "text": "所以现在外卖网约车才会饱和"
    },
    {
      "start": 255.88,
      "end": 257.88,
      "text": "深圳市的政府才会站出来说"
    },
    {
      "start": 257.88,
      "end": 259.96000000000004,
      "text": "不要再去搞外卖网约车了"
    },
    {
      "start": 259.96,
      "end": 263.47999999999996,
      "text": "官方青年失业率才会长期维持在"
    },
    {
      "start": 263.47999999999996,
      "end": 264.64,
      "text": "20%左右"
    },
    {
      "start": 264.64,
      "end": 266.23999999999995,
      "text": "真实情况可能更高"
    },
    {
      "start": 266.23999999999995,
      "end": 268.2,
      "text": "第三个结果就是财政赤字"
    },
    {
      "start": 268.2,
      "end": 269.68,
      "text": "就是我们现在看到的"
    },
    {
      "start": 269.68,
      "end": 271.28,
      "text": "地方政府债台高出"
    },
    {
      "start": 271.28,
      "end": 273.12,
      "text": "每年补贴这些高端行业"
    },
    {
      "start": 273.12,
      "end": 275.68,
      "text": "需要GDP的4%到4.4%"
    },
    {
      "start": 275.68,
      "end": 277.84,
      "text": "也就是5.6到6万亿元"
    },
    {
      "start": 277.84,
      "end": 279.52,
      "text": "这远远超出了一个"
    },
    {
      "start": 279.52,
      "end": 281.35999999999996,
      "text": "政府财政的增收能力"
    },
    {
      "start": 281.35999999999996,
      "end": 283.44,
      "text": "中央政府显然是无法承担的"
    },
    {
      "start": 283.44,
      "end": 285.12,
      "text": "那就需要地方支援了"
    },
    {
      "start": 285.12,
      "end": 286.59999999999997,
      "text": "地方政府为了完成"
    },
    {
      "start": 286.59999999999997,
      "end": 288.08,
      "text": "中央交代的产业任务"
    },
    {
      "start": 288.08,
      "end": 289.79999999999995,
      "text": "除了发行这些专项债券"
    },
    {
      "start": 289.84000000000003,
      "end": 292.08,
      "text": "一般债券这种显性的债务"
    },
    {
      "start": 292.08,
      "end": 294.8,
      "text": "绝大多数都要靠国资委下面那些"
    },
    {
      "start": 294.8,
      "end": 296.40000000000003,
      "text": "城投水投交投"
    },
    {
      "start": 296.40000000000003,
      "end": 298.44,
      "text": "这些融资平台进行融资"
    },
    {
      "start": 298.44,
      "end": 299.52000000000004,
      "text": "我们之前就说过"
    },
    {
      "start": 299.52000000000004,
      "end": 302.08000000000004,
      "text": "城投债绝对不是地方官员"
    },
    {
      "start": 302.08000000000004,
      "end": 303.40000000000003,
      "text": "乱搞搞出来的"
    },
    {
      "start": 303.40000000000003,
      "end": 305.40000000000003,
      "text": "而是中央的政策设计"
    },
    {
      "start": 305.40000000000003,
      "end": 306.44,
      "text": "人为造成的"
    },
    {
      "start": 306.44,
      "end": 308.48,
      "text": "早就知道的计划内的事情"
    },
    {
      "start": 308.48,
      "end": 310.36,
      "text": "所以说在全国总体上"
    },
    {
      "start": 310.36,
      "end": 312.68,
      "text": "也造成了中国的广义财政赤字"
    },
    {
      "start": 312.68,
      "end": 313.96000000000004,
      "text": "已经被推高到了"
    },
    {
      "start": 313.96000000000004,
      "end": 316.96000000000004,
      "text": "GDP的8%到12%"
    },
    {
      "start": 316.96000000000004,
      "end": 318.32,
      "text": "这个历史最高位"
    },
    {
      "start": 318.32,
      "end": 319.12,
      "text": "一般来说"
    },
    {
      "start": 319.16,
      "end": 321.08,
      "text": "这个新兴经济体和发达经济体"
    },
    {
      "start": 321.08,
      "end": 322.32,
      "text": "相比任性较弱"
    },
    {
      "start": 322.32,
      "end": 324.44,
      "text": "高于5%到6%"
    },
    {
      "start": 324.44,
      "end": 325.96,
      "text": "就容易引发危机了"
    },
    {
      "start": 325.96,
      "end": 328.04,
      "text": "何况是12%呢"
    },
    {
      "start": 328.04,
      "end": 330.0,
      "text": "而这些维持补贴的赤字"
    },
    {
      "start": 330.0,
      "end": 332.4,
      "text": "债务还会在将来越滚越大的"
    },
    {
      "start": 332.4,
      "end": 333.92,
      "text": "未来还债的压力"
    },
    {
      "start": 333.92,
      "end": 335.68,
      "text": "将进一步挤压民生"
    },
    {
      "start": 335.68,
      "end": 337.2,
      "text": "导致消费更弱"
    },
    {
      "start": 337.2,
      "end": 339.04,
      "text": "陷入需要更多的赤字"
    },
    {
      "start": 339.04,
      "end": 341.08,
      "text": "来稳增长的恶性循环"
    },
    {
      "start": 341.08,
      "end": 343.0,
      "text": "我们把以上的这几个因素"
    },
    {
      "start": 343.0,
      "end": 343.72,
      "text": "汇聚到一起"
    },
    {
      "start": 344.0,
      "end": 345.44,
      "text": "就造成了中国现在"
    },
    {
      "start": 345.44,
      "end": 347.84000000000003,
      "text": "最迫在眉睫的问题之一"
    },
    {
      "start": 347.84000000000003,
      "end": 350.00000000000006,
      "text": "就是全要素生产率"
    },
    {
      "start": 350.00000000000006,
      "end": 352.12,
      "text": "也就是TFP的损失"
    },
    {
      "start": 352.12,
      "end": 353.92,
      "text": "已经到达了1.2%"
    },
    {
      "start": 353.92,
      "end": 355.88000000000005,
      "text": "这个数据直接拉低了"
    },
    {
      "start": 355.88000000000005,
      "end": 358.00000000000006,
      "text": "2%左右的GDP增长"
    },
    {
      "start": 358.00000000000006,
      "end": 359.96000000000004,
      "text": "也就是上万亿的财富"
    },
    {
      "start": 359.96000000000004,
      "end": 361.32000000000005,
      "text": "就这么被蒸发掉了"
    },
    {
      "start": 361.32000000000005,
      "end": 363.08000000000004,
      "text": "那落实到个人身上"
    },
    {
      "start": 363.08000000000004,
      "end": 365.64000000000004,
      "text": "一个个老百姓能不反平吗"
    },
    {
      "start": 365.64000000000004,
      "end": 367.00000000000006,
      "text": "可能有些朋友要问了"
    },
    {
      "start": 367.00000000000006,
      "end": 369.28000000000003,
      "text": "什么是这个TFP呢"
    },
    {
      "start": 369.28000000000003,
      "end": 372.36,
      "text": "TFP衡量的是同样投入下"
    },
    {
      "start": 372.36,
      "end": 374.44000000000005,
      "text": "产出多少的整体效率值"
    },
    {
      "start": 374.44000000000005,
      "end": 375.52000000000004,
      "text": "就像一个工厂"
    },
    {
      "start": 375.52000000000004,
      "end": 376.68,
      "text": "老板投入的资本"
    },
    {
      "start": 376.72,
      "end": 379.04,
      "text": "比如说厂房、机器、钱"
    },
    {
      "start": 379.04,
      "end": 380.24,
      "text": "拼请了劳动力"
    },
    {
      "start": 380.24,
      "end": 382.08,
      "text": "最终用他们来产出产品"
    },
    {
      "start": 382.08,
      "end": 383.08,
      "text": "TFP越高"
    },
    {
      "start": 383.08,
      "end": 385.32,
      "text": "说明老板把厂房、机器和工人"
    },
    {
      "start": 385.32,
      "end": 387.28000000000003,
      "text": "这些资源配置的越有效率"
    },
    {
      "start": 387.28000000000003,
      "end": 388.56,
      "text": "TFP越低"
    },
    {
      "start": 388.56,
      "end": 390.68,
      "text": "则说明它配置的越没效率"
    },
    {
      "start": 390.68,
      "end": 392.12,
      "text": "中国现在问题就是"
    },
    {
      "start": 392.12,
      "end": 393.8,
      "text": "政府把资源倾斜到"
    },
    {
      "start": 393.8,
      "end": 395.04,
      "text": "所谓的高端产业"
    },
    {
      "start": 395.04,
      "end": 397.12,
      "text": "挤压所谓的中低端产业"
    },
    {
      "start": 397.12,
      "end": 399.08,
      "text": "导致中国的中低端产业"
    },
    {
      "start": 399.08,
      "end": 399.96000000000004,
      "text": "萎靡不振"
    },
    {
      "start": 399.96000000000004,
      "end": 401.08,
      "text": "绝大多数需要在"
    },
    {
      "start": 401.08,
      "end": 403.24,
      "text": "中低端产业就业的老百姓失业"
    },
    {
      "start": 403.24,
      "end": 404.12,
      "text": "没钱消费"
    },
    {
      "start": 404.12,
      "end": 405.64,
      "text": "就产生了恶性循环"
    }
  ],
