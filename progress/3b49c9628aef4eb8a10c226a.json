      "start": 69.16,
      "end": 70.2,
      "text": "中东局势升级"
    },
    {
      "start": 70.2,
      "end": 72.52000000000001,
      "text": "布伦特原有已经逼近创纪录的"
    },
    {
      "start": 72.52000000000001,
      "end": 73.64,
      "text": "115美元"
    },
    {
      "start": 73.88,
      "end": 76.16,
      "text": "下周还有微软谷歌亚马逊的财报"
    },
    {
      "start": 76.36,
      "end": 77.72,
