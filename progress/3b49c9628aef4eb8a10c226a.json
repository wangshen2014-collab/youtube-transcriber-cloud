    },
    {
      "start": 88.24000000000001,
      "end": 90.76,
      "text": "截至10月15号的五个交易日里边"
    },
    {
      "start": 91.08000000000001,
      "end": 93.64000000000001,
      "text": "对冲基金减持科技股仓位的比例"
    },
    {
      "start": 93.64000000000001,
