    {
      "start": 1056.68,
      "end": 1058.46,
      "text": "有史以來我看過最好的"
    },
    {
      "start": 1058.72,
      "end": 1061.28,
      "text": "比Fable的還好就真的是"
    },
    {
      "start": 1061.54,
      "end": 1062.5600000000002,
      "text": "超棒的一個"
