    {
      "start": 989.6,
      "end": 992.6800000000001,
      "text": "GPT-6 Astra的電腦實用能力"
    },
    {
      "start": 992.94,
      "end": 996.26,
      "text": "這是我看到他電腦實用能力我想到的一層我覺得"
