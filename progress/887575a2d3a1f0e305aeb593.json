    {
      "start": 320.08,
      "end": 320.96,
      "text": "在这种情况下"
    },
    {
      "start": 321.03999999999996,
      "end": 323.68,
      "text": "董事会明知为归还保黄仁勋的话"
    },
    {
      "start": 323.68,
      "end": 326.32,
      "text": "那么下一个被告的就是董事他们自己"
    },
    {
      "start": 326.32,
      "end": 327.91999999999996,
      "text": "还有一个更加扎心的问题"
    },
    {
      "start": 327.91999999999996,
      "end": 329.03999999999996,
      "text": "就在星期天董事会"
