    {
      "start": 357.44,
      "end": 359.12,
      "text": "他们要和黄仁勋进行切割"
    },
    {
      "start": 359.12,
      "end": 360.32,
      "text": "现在基本上没有任何人"
    },
    {
      "start": 360.32,
      "end": 361.52000000000004,
      "text": "可以救黄仁勋了"
