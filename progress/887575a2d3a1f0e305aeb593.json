    {
      "start": 329.03999999999996,
      "end": 330.64,
      "text": "还在力挺黄仁勋的时候"
    },
    {
      "start": 330.64,
      "end": 331.84,
      "text": "董事会到底知不知道"
    },
    {
      "start": 331.84,
      "end": 334.15999999999997,
      "text": "黄仁勋他的第二段红红爱情关系"
    },
    {
      "start": 334.15999999999997,
      "end": 335.76,
      "text": "如果董事会不知道"
