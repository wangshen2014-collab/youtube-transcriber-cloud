    {
      "start": 352.6,
      "end": 354.64,
      "text": "14家卖方机构"
    },
    {
      "start": 354.64,
      "end": 357.14,
      "text": "就开始下调评级和目标价"
    },
    {
      "start": 357.14,
      "end": 358.3,
      "text": "那么"
