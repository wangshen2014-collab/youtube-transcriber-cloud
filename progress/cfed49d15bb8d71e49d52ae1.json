    },
    {
      "start": 266.12,
      "end": 268.1,
      "text": "现如今"
    },
    {
      "start": 268.88,
      "end": 271.38,
      "text": "战略的坚定的执行者离开了"
    },
    {
      "start": 271.38,
      "end": 272.9,
      "text": "那么问题就来了"
    },
    {
      "start": 272.9,
      "end": 274.78,
      "text": "新的继任者"
    },
    {
      "start": 274.78,
      "end": 277.2,
      "text": "还会继承这一战略吗"
    },
    {
      "start": 277.2,
      "end": 279.8,
      "text": "今天纽约时报"
    },
    {
      "start": 279.8,
      "end": 281.94,
      "text": "是援引消息人士报道说"
