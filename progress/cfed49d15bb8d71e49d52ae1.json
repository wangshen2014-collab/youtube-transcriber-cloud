    },
    {
      "start": 67.84,
      "end": 70.03999999999999,
      "text": "低于9月的1.4%"
    },
    {
      "start": 70.03999999999999,
      "end": 72.1,
      "text": "也低于预期的0.4"
    },
    {
      "start": 72.1,
      "end": 76.36,
      "text": "同比的涨幅是从6.3%"
    },
    {
      "start": 76.36,
      "end": 78.3,
      "text": "升到了6.5%"
    },
    {
      "start": 78.3,
      "end": 81.0,
      "text": "但是低于预期的6.6%"
    },
    {
      "start": 81.0,
      "end": 83.98,
