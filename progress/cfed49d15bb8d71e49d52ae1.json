    {
      "start": 303.12,
      "end": 305.0,
      "text": "他要跑路了"
    },
    {
      "start": 305.0,
      "end": 307.06,
      "text": "这个对于AI行业来讲"
    },
    {
      "start": 307.06,
      "end": 308.86,
      "text": "绝对是个沉重的打击"
    },
    {
      "start": 308.86,
      "end": 309.98,
      "text": "为什么呢"
    },
    {
      "start": 309.98,
      "end": 312.15999999999997,
      "text": "这个就不得不让我想起来"
    },
    {
      "start": 312.15999999999997,
      "end": 314.12,
      "text": "2000年的斯科"
    },
    {
      "start": 314.12,
      "end": 317.8,
      "text": "当时就是斯科主导的"
    },
    {
      "start": 317.8,
      "end": 320.7,
      "text": "循环信贷融资泡沫破灭"
    },
    {
      "start": 320.7,
      "end": 323.14,
      "text": "后来加速了2000年的互联网泡沫"
    },
    {
      "start": 323.14,
      "end": 325.14,
      "text": "这个故事我们在以前的节目里"
    },
    {
      "start": 325.14,
      "end": 325.9,
      "text": "跟大家讲过"
    },
    {
      "start": 325.9,
      "end": 328.86,
      "text": "在过去的两三年的时候"
    },
    {
      "start": 328.88,
      "end": 329.4,
      "text": "时间里边"
    },
    {
      "start": 329.4,
      "end": 330.86,
      "text": "人工智能行业"
    },
    {
      "start": 330.86,
      "end": 333.24,
      "text": "除了依赖超大规模数据中心"
