    },
    {
      "start": 29.04,
      "end": 31.259999999999998,
      "text": "没想到它是掏出了枪"
    },
    {
      "start": 31.259999999999998,
      "end": 34.12,
      "text": "咱们今天先说一下数据"
    },
    {
      "start": 34.12,
      "end": 37.5,
      "text": "然后再分析一件和人工智能发展"
    },
