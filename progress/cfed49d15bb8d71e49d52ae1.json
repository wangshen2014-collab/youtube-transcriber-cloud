    },
    {
      "start": 44.98,
      "end": 46.32,
      "text": "另外今天的节目"
    },
    {
      "start": 46.32,
      "end": 48.22,
      "text": "还会跟踪一下大家平常"
    },
    {
      "start": 48.22,
      "end": 51.239999999999995,
      "text": "今天包括波动比较大的几只个股"
    },
    {
      "start": 51.239999999999995,
      "end": 52.8,
      "text": "在咱们的标题上"
    },
    {
      "start": 52.8,
      "end": 54.56,
      "text": "好 首先我们看一下"
    },
    {
      "start": 54.56,
      "end": 57.66,
      "text": "今天的一组生产者物价指数"
    },
    {
      "start": 59.04,
      "end": 63.7,
