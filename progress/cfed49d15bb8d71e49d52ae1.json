    },
    {
      "start": 5.4,
      "end": 7.0600000000000005,
      "text": "2016年11月13号"
    },
    {
      "start": 7.0600000000000005,
      "end": 9.0,
      "text": "周五晚上的8点25分"
    },
    {
      "start": 9.0,
      "end": 12.24,
      "text": "今天是道指独掌"
    },
