    },
    {
      "start": 98.9,
      "end": 102.72,
      "text": "这个加息预期还是比较慢的"
    },
    {
      "start": 102.72,
      "end": 105.64000000000001,
      "text": "好 这个就是目前整个的"
    },
    {
      "start": 105.64000000000001,
      "end": 108.14000000000001,
      "text": "在利率市场的一个情况"
    },
    {
      "start": 108.14000000000001,
      "end": 110.10000000000001,
      "text": "因为这个利率的情况"
