    {
      "start": 258.52,
      "end": 260.9,
      "text": "推到了全球市值第一的宝座"
    },
    {
      "start": 260.9,
      "end": 262.86,
      "text": "当然现在随着英伟达"
    },
    {
      "start": 262.86,
      "end": 263.98,
      "text": "连续的下跌"
