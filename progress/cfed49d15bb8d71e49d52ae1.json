    },
    {
      "start": 345.18,
      "end": 347.21999999999997,
      "text": "刚刚失去了CEO"
    },
    {
      "start": 347.21999999999997,
      "end": 347.94,
      "text": "哎呀"
    },
    {
      "start": 347.94,
      "end": 348.48,
      "text": "而且呢"
