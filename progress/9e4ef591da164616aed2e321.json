    {
      "start": 781.54,
      "end": 783.54,
      "text": "在意的點是什麼"
    },
    {
      "start": 783.54,
      "end": 785.54,
      "text": "然後他們會往哪邊推進"
    },
    {
      "start": 785.54,
      "end": 787.54,
      "text": "這一步我就沒有辦法考慮到"
    },
    {
      "start": 787.54,
      "end": 789.54,
      "text": "我不懂"
    },
    {
      "start": 789.54,
      "end": 791.54,
      "text": "但我可以從一些技術的角度"
    },
    {
      "start": 791.54,
      "end": 793.54,
      "text": "來跟大家討論一下"
    },
    {
      "start": 793.54,
      "end": 795.54,
      "text": "有哪些關鍵條件必須要達成"
    },
    {
      "start": 795.54,
      "end": 797.54,
      "text": "以及達成的可能性"
    },
    {
      "start": 797.54,
      "end": 799.54,
      "text": "首先NVIDIA要成功"
    },
    {
      "start": 799.54,
      "end": 801.54,
      "text": "其實它有兩項最大的關鍵"
    },
    {
      "start": 801.54,
      "end": 803.54,
      "text": "第一個就是GPU"
    },
    {
      "start": 803.54,
      "end": 805.54,
      "text": "未來必須持續產生"
    },
    {
      "start": 805.54,
      "end": 807.54,
      "text": "GPU的現金流"
    },
    {
      "start": 807.54,
      "end": 809.54,
      "text": "這個是最低的標準"
    },
    {
      "start": 809.54,
      "end": 811.54,
      "text": "一個必要條件"
    },
    {
      "start": 811.54,
      "end": 813.54,
      "text": "假設GPU沒辦法產生穩定的現金流"
    },
    {
      "start": 813.54,
      "end": 815.54,
      "text": "這些外部的資金"
    },
    {
      "start": 815.54,
      "end": 817.54,
      "text": "沒有人會想要接的"
    },
    {
      "start": 817.54,
      "end": 819.54,
      "text": "沒有人會想要投資的"
    },
    {
      "start": 819.54,
      "end": 821.54,
      "text": "它必須要像房地產一樣"
    },
    {
      "start": 821.54,
      "end": 823.54,
      "text": "有穩定租金"
    },
    {
      "start": 823.54,
      "end": 825.54,
      "text": "這樣子的東西才可以"
    },
    {
      "start": 825.54,
      "end": 827.54,
      "text": "針對現金流這一點"
    },
    {
      "start": 827.54,
      "end": 829.54,
      "text": "我覺得AI運算需求"
    },
    {
      "start": 829.54,
      "end": 831.54,
      "text": "總體的需求"
    },
    {
      "start": 831.54,
      "end": 833.54,
      "text": "絕對沒有問題"
    },
    {
      "start": 833.54,
      "end": 835.54,
      "text": "而且會很大量"
    },
    {
      "start": 835.54,
      "end": 837.54,
      "text": "我覺得真的跟房地產一樣"
    },
    {
      "start": 837.54,
      "end": 839.54,
      "text": "人都要住房子"
    },
    {
      "start": 839.54,
      "end": 841.54,
      "text": "人travel到一個地方"
    },
    {
      "start": 841.54,
      "end": 843.54,
      "text": "就是要住飯店"
    },
    {
      "start": 843.54,
      "end": 845.54,
      "text": "一樣的道理"
    },
    {
      "start": 845.54,
      "end": 847.54,
      "text": "未來人就是要用AI"
    },
    {
      "start": 847.54,
      "end": 849.54,
      "text": "所有事情都會需要用到AI"
    },
    {
      "start": 849.54,
      "end": 851.54,
      "text": "算力需求絕對是沒有問題的"
    },
    {
      "start": 851.54,
      "end": 853.54,
      "text": "但問題是出在於"
    },
    {
      "start": 853.54,
      "end": 855.54,
      "text": "提供這些算力的AI晶片"
    },
    {
      "start": 855.54,
      "end": 857.54,
      "text": "到底還會不會是以GPU為主"
    },
    {
      "start": 857.54,
      "end": 859.54,
      "text": "NVIDIA為主"
    },
    {
      "start": 859.54,
      "end": 861.54,
      "text": "在兩三年內"
    },
    {
      "start": 861.54,
      "end": 863.54,
      "text": "我覺得無庸置疑絕對都會是"
    },
    {
      "start": 863.54,
      "end": 865.54,
      "text": "但是"
    },
    {
      "start": 865.54,
      "end": 867.54,
      "text": "你要我預測三年之外"
    },
    {
      "start": 867.54,
      "end": 869.54,
      "text": "我自己覺得我的"
    },
    {
      "start": 869.54,
      "end": 871.54,
      "text": "不確定性就會"
    },
    {
      "start": 871.54,
      "end": 873.54,
      "text": "蠻大幅的提升了"
    },
    {
      "start": 873.54,
      "end": 875.54,
      "text": "因為真的到時候"
    },
    {
      "start": 875.54,
      "end": 877.54,
      "text": "我覺得還是要看"
    },
    {
      "start": 877.54,
      "end": 879.54,
      "text": "AI運算的架構本身"
    },
    {
      "start": 879.54,
      "end": 881.54,
      "text": "AI workload本身"
    },
    {
      "start": 881.54,
      "end": 883.54,
      "text": "未來到底會變成什麼樣"
    },
    {
      "start": 883.54,
      "end": 885.54,
      "text": "現在還在劇烈變動當中"
    },
    {
      "start": 885.54,
      "end": 887.54,
      "text": "假設未來AI模型的架構"
    },
    {
      "start": 887.54,
      "end": 889.54,
      "text": "真的定下來了"
    }
